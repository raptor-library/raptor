@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@WITH_MPI@)
  find_dependency(MPI COMPONENTS CXX)
endif()

if(NOT DEFINED BLA_VENDOR AND NOT "@RAPTOR_BLA_VENDOR@" STREQUAL "")
  set(BLA_VENDOR "@RAPTOR_BLA_VENDOR@")
endif()
find_dependency(LAPACK)

if(@WITH_MFEM@)
  find_dependency(MFEM CONFIG)
endif()

if(@WITH_MUELU@)
  find_dependency(MueLu CONFIG)
endif()

if(NOT TARGET raptor::raptor)
  include("${CMAKE_CURRENT_LIST_DIR}/raptorTargets.cmake")
endif()

check_required_components(raptor)
